# =============================================
# HedgeFi Agent (Seller/Provider)
# =============================================
# Whitelisted developer wallet private key (0x-prefixed)
HEDGEFI_PRIVATE_KEY=0x...

# Entity ID from ACP Service Registry (number)
HEDGEFI_ENTITY_ID=123

# Smart wallet address from ACP Service Registry (0x-prefixed)
HEDGEFI_WALLET_ADDRESS=0xC2CD85B007AE1EfCec2679AA37A2e162DE85E804

# =============================================
# Test Buyer Agent
# =============================================
BUYER_PRIVATE_KEY=0x...
BUYER_ENTITY_ID=456
BUYER_WALLET_ADDRESS=0x...

# =============================================
# Google Gemini (for AI reasoning)
# =============================================
GEMINI_API_KEY=...

# =============================================
# RPC URLs (optional — defaults to public RPCs)
# =============================================
BASE_RPC_URL=https://mainnet.base.org
ETH_RPC_URL=https://eth.llamarpc.com
ARB_RPC_URL=https://arb1.arbitrum.io/rpc

# =============================================
# CoinGecko (optional — free tier works without key)
# =============================================
COINGECKO_API_KEY=
